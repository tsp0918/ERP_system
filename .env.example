# ==================================================================
# ERP System - Environment Variables
# ==================================================================

# --- Application ---
APP_NAME="Mini Global ERP"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database ---
# SQLite (default for local dev - no setup required)
DATABASE_URL=sqlite:///./erp.db

# PostgreSQL (uncomment for production-like local dev)
# DATABASE_URL=postgresql://erp:erp@localhost:5432/erp

# --- Auth ---
SECRET_KEY=change-this-to-a-strong-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Long-lived token for machine-to-machine callers (POST /auth/service-token)
# Default 24 h; raise to e.g. 168 (1 week) for batch systems that cannot refresh hourly
M2M_TOKEN_EXPIRE_HOURS=24
ALGORITHM=HS256

# --- AI Trade Management Integration (引き継ぎ書 v2.4) ---
# Set MOCK_MODE=true if AI_TradeManagement is not running locally
AI_TM_MOCK_MODE=true
AI_TM_TIMEOUT_SECONDS=30
# Days a transaction review remains valid before re-review is required
AI_TM_REVIEW_VALID_DAYS=365

# 認証ヘッダー (Basic認証なし、組織/ユーザーIDをヘッダーで送信)
AI_TM_ORG_ID=erp-system
AI_TM_USER_ID=erp-integration@system

# モジュール別URL
AI_TM_CLASSIFICATION_URL=http://localhost:8002
AI_TM_VALIDATION_URL=http://localhost:8011
AI_TM_SCREENING_URL=http://localhost:8005
AI_TM_RND_URL=http://localhost:8003
AI_TM_LICENSE_URL=http://localhost:8012
AI_TM_CORE_URL=http://localhost:8000

# 後方互換 (旧ゲートウェイ)
AI_TM_BASE_URL=http://localhost:5001
AI_TM_API_KEY=dev-erp-integration-key

# --- Initial Admin (created by seed script) ---
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=admin1234

# ==================================================================
# CRM Integration (Phase 0〜)
# ==================================================================

# CRM → ERP inbound auth (HMAC-SHA256 + Bearer)
# Exchange these values with the CRM team before going live.
CRM_INBOUND_BEARER=
CRM_INBOUND_SIGNING_SECRET=
CRM_INBOUND_SIGNING_SECRET_PREVIOUS=   # Set during key rotation; clear after both sides rotate

# AI_TM → ERP inbound auth (upgrades the existing API key to HMAC)
AITM_INBOUND_BEARER=
AITM_INBOUND_SIGNING_SECRET=

# ERP → CRM outbound webhooks
CRM_WEBHOOK_BASE_URL=                                  # e.g. https://crm.example.com
CRM_WEBHOOK_BEARER=
CRM_WEBHOOK_SIGNING_SECRET=
CRM_WEBHOOK_PATH_MATERIAL_UPDATED=/webhooks/erp/material-updated
CRM_WEBHOOK_PATH_BP_UPDATED=/webhooks/erp/bp-updated
CRM_WEBHOOK_PATH_DELIVERY_POSTED=/webhooks/erp/delivery-posted
CRM_WEBHOOK_PATH_BILLING_POSTED=/webhooks/erp/billing-posted
CRM_WEBHOOK_PATH_RETURN_POSTED=/webhooks/erp/return-posted

# ERP → AI_TM outbound request signing
AITM_REQUEST_SIGNING_SECRET=

# Commerce check stub (IF-32): set to false when a real provider is integrated
COMMERCE_CHECK_STUB_MODE=true

# Webhook delivery worker
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_CONNECT_TIMEOUT_SEC=5
WEBHOOK_READ_TIMEOUT_SEC=10
WEBHOOK_WORKER_INTERVAL_SEC=30

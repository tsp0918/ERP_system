{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ERP: uvicorn (port 8888, reload)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--port",
                "8888"
            ],
            "console": "integratedTerminal",
            "jinja": true,
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "AI_TM Stub: uvicorn (port 5001, reload)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "ai_tm_stub.main:app",
                "--reload",
                "--port",
                "5001"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "ERP: uvicorn (port 8888, no reload, full debug)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--port",
                "8888"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Seed: base (MDM/SD)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/seed.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Seed: PP (BOM + Costing)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/seed_pp.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Seed: MM (Procurement)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/seed_mm.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Seed: PP Execution (Process Order + Genealogy)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/seed_pp_execution.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Seed: FI / HR / PDF (auto-postings, employees, invoices)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/seed_fi_hr.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Integration Test (ERP <-> AI_TM Stub)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/integration_test.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "pytest: all (unit + service tests)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-v"],
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "pytest: with coverage",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["--cov=app", "--cov-report=term"],
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env"
        }
    ],
    "compounds": [
        {
            "name": "Both: ERP + AI_TM Stub",
            "configurations": [
                "ERP: uvicorn (port 8888, reload)",
                "AI_TM Stub: uvicorn (port 5001, reload)"
            ],
            "stopAll": true
        }
    ]
}

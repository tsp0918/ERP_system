# ==================================================================
# ERP System - テストインスタンス用環境変数
# port 9001 / erp_test.db で起動する E2E テスト専用環境
# ./start.sh --test で読み込まれる
# ==================================================================

# --- Application ---
APP_NAME="Mini Global ERP (TEST)"
APP_VERSION="0.1.0"
ENVIRONMENT=test
DEBUG=true
LOG_LEVEL=INFO

# --- Database (テスト専用 DB — reset-test で初期化) ---
DATABASE_URL=sqlite:///./erp_test.db

# --- Auth ---
SECRET_KEY=test-secret-key-not-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
M2M_TOKEN_EXPIRE_HOURS=24
ALGORITHM=HS256

# --- Initial Admin ---
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=admin1234

# --- AI Trade Management (テスト環境では Mock モード) ---
AI_TM_MOCK_MODE=true
AI_TM_TIMEOUT_SECONDS=30
AI_TM_REVIEW_VALID_DAYS=365
AI_TM_ORG_ID=erp-system-test
AI_TM_USER_ID=erp-integration-test@system
AI_TM_CLASSIFICATION_URL=http://localhost:8002
AI_TM_VALIDATION_URL=http://localhost:8011
AI_TM_SCREENING_URL=http://localhost:8005
AI_TM_RND_URL=http://localhost:8003
AI_TM_LICENSE_URL=http://localhost:8012
AI_TM_CORE_URL=http://localhost:8000
AI_TM_BASE_URL=http://localhost:5001
AI_TM_API_KEY=dev-erp-integration-key

# --- CRM Integration ---
CRM_CLIENT_ID=DEMO
CRM_INBOUND_BEARER=
CRM_INBOUND_SIGNING_SECRET=
CRM_WEBHOOK_BASE_URL=
CRM_WEBHOOK_BEARER=
CRM_WEBHOOK_SIGNING_SECRET=

# --- Commerce Check (スタブモード) ---
COMMERCE_CHECK_STUB_MODE=true

# --- Webhook Worker ---
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_CONNECT_TIMEOUT_SEC=5
WEBHOOK_READ_TIMEOUT_SEC=10
WEBHOOK_WORKER_INTERVAL_SEC=30
